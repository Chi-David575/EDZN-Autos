# --- Database ---
# Get this connection string from Supabase (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Server ---
PORT=4000
# Comma-separated list of origins allowed to call this API (your hosted frontend URL)
ALLOWED_ORIGINS=https://edznautos.com,http://localhost:5500

# --- Admin ---
# Password required to unlock the admin dashboard in the frontend. Change this.
ADMIN_PASSWORD=change-this-before-launch

# --- Anthropic (AI Car Doctor) ---
# Get a key at console.anthropic.com. NEVER put this in frontend code.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Paystack ---
# Get these from dashboard.paystack.com -> Settings -> API Keys & Webhooks
# Start with the TEST keys (pk_test_/sk_test_) until you're ready to go live.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
